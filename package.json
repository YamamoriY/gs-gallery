{
  "name": "gs-gallery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run vendor",
    "dev": "next dev",
    "prebuild": "npm run vendor",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "vendor": "node scripts/build-viewer.mjs && node scripts/vendor-maplibre.mjs",
    "viewer": "node scripts/build-viewer.mjs",
    "scan": "node scripts/scan.mjs",
    "thumbs": "node scripts/thumbs.mjs",
    "convert": "node scripts/convert.mjs",
    "scale": "node scripts/measure-scale.mjs",
    "prepare-data": "npm run convert && npm run scale && npm run scan"
  },
  "dependencies": {
    "maplibre-gl": "^6.7.0",
    "next": "^16.0.7",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playcanvas/splat-transform": "^3.3.3",
    "@playcanvas/supersplat-viewer": "^1.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
